<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MiningCalculator.MainPage"
             xmlns:behaviors="clr-namespace:MiningCalculator.Behaviors"
             xmlns:vm="clr-namespace:MiningCalculator.ViewModels"
             x:DataType="vm:MainPageViewModel"
             Title="Mining Calculator">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <!-- Relative Density Section -->
            <Label Text="Substance and Relative Density"
                   FontAttributes="Bold,Italic" FontSize="14" />

            <Picker Title="Select substance"
                    ItemsSource="{Binding SubstanceNames}"
                    SelectedIndex="{Binding SelectedSubstanceIndex}"
                    IsEnabled="{Binding IsPickerEnabled}" />

            <HorizontalStackLayout Spacing="0">
                <CheckBox IsChecked="{Binding IsManualDensity}" VerticalOptions="Center" />
                <Label Text="Manual Relative Density"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Entry Text="{Binding ManualDensityText}"
                   Placeholder="Enter relative density"
                   Keyboard="Numeric"
                   IsEnabled="{Binding IsManualDensityEntryEnabled}">
                <Entry.Behaviors>
                    <behaviors:NumericValidationBehavior />
                </Entry.Behaviors>
            </Entry>

            <!-- Shape Selector -->
            <Label Text="Shape" FontAttributes="Bold" FontSize="16"
                   Margin="0,10,0,0" />

            <HorizontalStackLayout Spacing="20">
                <RadioButton Content="Rectangle / Cube"
                             IsChecked="{Binding IsRectangleSelected}" />
                <RadioButton Content="Cylinder"
                             IsChecked="{Binding IsCylinderSelected}" />
            </HorizontalStackLayout>

            <!-- Rectangle Section -->
            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                   Padding="15" IsVisible="{Binding IsRectangleVisible}"
                   StrokeShape="RoundRectangle 12"
                   Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Rectangle / Cube Shape"
                           FontAttributes="Italic" FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource SectionText}, Dark={StaticResource SectionTextDark}}" />

                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="8" RowSpacing="8">

                        <Label Text="Length :" Grid.Row="0" Grid.Column="0"
                               VerticalOptions="Center" />
                        <Entry Text="{Binding LengthText}" Grid.Row="0" Grid.Column="1" Keyboard="Numeric">
                            <Entry.Behaviors>
                                <behaviors:NumericValidationBehavior />
                            </Entry.Behaviors>
                        </Entry>
                        <Label Text="meter(s)" Grid.Row="0" Grid.Column="2"
                               VerticalOptions="Center" />

                        <Label Text="Width :" Grid.Row="1" Grid.Column="0"
                               VerticalOptions="Center" />
                        <Entry Text="{Binding WidthText}" Grid.Row="1" Grid.Column="1" Keyboard="Numeric">
                            <Entry.Behaviors>
                                <behaviors:NumericValidationBehavior />
                            </Entry.Behaviors>
                        </Entry>
                        <Label Text="meter(s)" Grid.Row="1" Grid.Column="2"
                               VerticalOptions="Center" />

                        <Label Text="Height :" Grid.Row="2" Grid.Column="0"
                               VerticalOptions="Center" />
                        <Entry Text="{Binding HeightText}" Grid.Row="2" Grid.Column="1" Keyboard="Numeric">
                            <Entry.Behaviors>
                                <behaviors:NumericValidationBehavior />
                            </Entry.Behaviors>
                        </Entry>
                        <Label Text="meter(s)" Grid.Row="2" Grid.Column="2"
                               VerticalOptions="Center" />

                        <Label Text="Answer :" Grid.Row="3" Grid.Column="0"
                               VerticalOptions="Center" />
                        <Label Text="{Binding RectangleAnswer}" Grid.Row="3" Grid.Column="1"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource ResultText}, Dark={StaticResource ResultTextDark}}"
                               VerticalOptions="Center" FontSize="16" />
                    </Grid>

                    <Button Text="Calculate" Command="{Binding CalculateRectangleCommand}"
                            HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                   Padding="15" IsVisible="{Binding IsCylinderVisible}"
                   StrokeShape="RoundRectangle 12"
                   Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Cylinder Shape"
                           FontAttributes="Italic" FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource SectionText}, Dark={StaticResource SectionTextDark}}" />

                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto"
                          ColumnSpacing="8" RowSpacing="8">

                        <Label Text="Diameter :" Grid.Row="0" Grid.Column="0"
                               VerticalOptions="Center" />
                        <Entry Text="{Binding DiameterText}" Grid.Row="0" Grid.Column="1">
                            <Entry.Behaviors>
                                <behaviors:NumericValidationBehavior />
                            </Entry.Behaviors>
                        </Entry>
                        <Label Text="meter(s)" Grid.Row="0" Grid.Column="2"
                               VerticalOptions="Center" />

                        <Label Text="Height :" Grid.Row="1" Grid.Column="0"
                               VerticalOptions="Center" />
                        <Entry Text="{Binding CylinderHeightText}" Grid.Row="1" Grid.Column="1">
                            <Entry.Behaviors>
                                <behaviors:NumericValidationBehavior />
                            </Entry.Behaviors>
                        </Entry>
                        <Label Text="meter(s)" Grid.Row="1" Grid.Column="2"
                               VerticalOptions="Center" />

                        <Label Text="Answer :" Grid.Row="2" Grid.Column="0"
                               VerticalOptions="Center" />
                        <Label Text="{Binding CylinderAnswer}" Grid.Row="2" Grid.Column="1"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource ResultText}, Dark={StaticResource ResultTextDark}}"
                               VerticalOptions="Center" FontSize="16" />
                    </Grid>

                    <Button Text="Calculate" Command="{Binding CalculateCylinderCommand}"
                            HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding VersionText}" FontSize="10"
                   HorizontalOptions="End"
                   TextColor="{AppThemeBinding Light={StaticResource MutedText}, Dark={StaticResource MutedTextDark}}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
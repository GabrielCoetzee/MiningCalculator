<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MiningCalculator.AboutPage"
             Title="About">

    <VerticalStackLayout Padding="30" Spacing="12"
                         VerticalOptions="Center">
        <Label x:Name="lblProductName" FontSize="22" FontAttributes="Bold"
               HorizontalOptions="Center" />
        <Label x:Name="lblVersion" FontSize="16" HorizontalOptions="Center" />
        <Label x:Name="lblDescription" FontSize="14" HorizontalOptions="Center" />
        <Label x:Name="lblCopyright" FontSize="12" TextColor="Gray"
               HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>
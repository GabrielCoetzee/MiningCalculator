<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MiningCalculator.ViewModels"
             x:Class="MiningCalculator.AboutPage"
             x:DataType="vm:AboutPageViewModel"
             Title="About">

    <VerticalStackLayout Padding="30" Spacing="12"
                         VerticalOptions="Center">
        <Label Text="{Binding ProductName}" FontSize="22" FontAttributes="Bold"
               HorizontalOptions="Center" />
        <Label Text="{Binding Version}" FontSize="16" HorizontalOptions="Center" />
        <Label Text="{Binding Description}" FontSize="14" HorizontalOptions="Center" />
        <Label Text="{Binding Copyright}" FontSize="12"
               TextColor="{AppThemeBinding Light={StaticResource MutedText}, Dark={StaticResource MutedTextDark}}"
               HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>
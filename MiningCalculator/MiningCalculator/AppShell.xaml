<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:MiningCalculator"
       x:Class="MiningCalculator.AppShell"
       Title="Mining Calculator"
       FlyoutBehavior="Flyout">

    <FlyoutItem Title="Calculator" Icon="dotnet_bot.png">
        <ShellContent Title="Calculator"
                      ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Gold" Icon="dotnet_bot.png">
        <ShellContent Title="Gold"
                      ContentTemplate="{DataTemplate local:GoldPage}" />
    </FlyoutItem>

    <FlyoutItem Title="About" Icon="dotnet_bot.png">
        <ShellContent Title="About"
                      ContentTemplate="{DataTemplate local:AboutPage}" />
    </FlyoutItem>

</Shell>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MiningCalculator.GoldPage"
             xmlns:behaviors="clr-namespace:MiningCalculator.Behaviors"
             xmlns:vm="clr-namespace:MiningCalculator.ViewModels"
             x:DataType="vm:GoldPageViewModel"
             Title="Gold">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <!-- G/Ton Section -->
            <Label Text="G/Ton" FontAttributes="Bold,Italic" FontSize="20"
                   TextColor="{AppThemeBinding Light={StaticResource GoldAccent}, Dark={StaticResource GoldAccentDark}}"
                   HorizontalOptions="Center" />

            <HorizontalStackLayout Spacing="10">
                <CheckBox IsChecked="{Binding IsStopingWidthCm}" />
                <Label Text="Stoping width in centimeters"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="8" RowSpacing="8">

                <Label Text="CMGT :" Grid.Row="0" Grid.Column="0"
                       VerticalOptions="Center" />
                <Entry Text="{Binding CmgtText}" Grid.Row="0" Grid.Column="1" Keyboard="Numeric">
                    <Entry.Behaviors>
                        <behaviors:NumericValidationBehavior />
                    </Entry.Behaviors>
                </Entry>

                <Label Text="Stoping Width (SW) :" Grid.Row="1" Grid.Column="0"
                       VerticalOptions="Center" />
                <Entry Text="{Binding StopingWidthText}" Grid.Row="1" Grid.Column="1" Keyboard="Numeric">
                    <Entry.Behaviors>
                        <behaviors:NumericValidationBehavior />
                    </Entry.Behaviors>
                </Entry>
                <Label Text="{Binding StopingWidthUnit}"
                       Grid.Row="1" Grid.Column="2"
                       FontAttributes="Bold" VerticalOptions="Center" />

                <Label Text="Answer :" Grid.Row="2" Grid.Column="0"
                       VerticalOptions="Center" />
                <Label Text="{Binding AnswerGPerTon}" Grid.Row="2" Grid.Column="1"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource ResultText}, Dark={StaticResource ResultTextDark}}"
                       FontSize="16"
                       VerticalOptions="Center" />
            </Grid>

            <Button Text="Calculate G/Ton" Command="{Binding CalculateGPerTonCommand}"
                    HorizontalOptions="Center" />

            <!-- Tons Section -->
            <Label Text="Tons" FontAttributes="Bold,Italic" FontSize="20"
                   TextColor="{AppThemeBinding Light={StaticResource GoldAccent}, Dark={StaticResource GoldAccentDark}}"
                   HorizontalOptions="Center" Margin="0,10,0,0" />

            <HorizontalStackLayout Spacing="10">
                <CheckBox IsChecked="{Binding CalcSquareMeters}" />
                <Label Text="Calculate Square Meters"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnSpacing="8" RowSpacing="8">

                <Label Text="Face Length :" Grid.Row="0" Grid.Column="0"
                       FontAttributes="Bold" VerticalOptions="Center" />
                <Entry Text="{Binding FaceLengthText}" Grid.Row="0" Grid.Column="1"
                       IsEnabled="{Binding IsFaceLengthEnabled}" />
                <Label Text="meter(s)" Grid.Row="0" Grid.Column="2"
                       FontAttributes="Bold" VerticalOptions="Center" />

                <Label Text="Face Advance :" Grid.Row="1" Grid.Column="0"
                       FontAttributes="Bold" VerticalOptions="Center" />
                <Entry Text="{Binding FaceAdvanceText}" Grid.Row="1" Grid.Column="1"
                       IsEnabled="{Binding IsFaceAdvanceEnabled}" />
                <Label Text="meter(s)" Grid.Row="1" Grid.Column="2"
                       FontAttributes="Bold" VerticalOptions="Center" />

                <Label Text="Square Metres :" Grid.Row="2" Grid.Column="0"
                       VerticalOptions="Center" />
                <Entry Text="{Binding SquareMetresText}" Grid.Row="2" Grid.Column="1"
                       IsEnabled="{Binding IsSquareMetresEnabled}" />
                <Label Text="m²" Grid.Row="2" Grid.Column="2"
                       VerticalOptions="Center" />

                <Label Text="Answer :" Grid.Row="3" Grid.Column="0"
                       VerticalOptions="Center" />
                <Label Text="{Binding AnswerTons}" Grid.Row="3" Grid.Column="1"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource ResultText}, Dark={StaticResource ResultTextDark}}"
                       FontSize="16"
                       VerticalOptions="Center" />
            </Grid>

            <Button Text="Calculate Tons" Command="{Binding CalculateTonsCommand}"
                    HorizontalOptions="Center" />

            <Label Text="Gold" FontAttributes="Bold,Italic" FontSize="20"
                   TextColor="{AppThemeBinding Light={StaticResource GoldAccent}, Dark={StaticResource GoldAccentDark}}"
                   HorizontalOptions="Center" Margin="0,10,0,0" />

            <HorizontalStackLayout Spacing="8">
                <Label Text="Answer :" VerticalOptions="Center" />
                <Label Text="{Binding AnswerGold}" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource ResultText}, Dark={StaticResource ResultTextDark}}"
                       FontSize="16" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button Text="Calculate Gold" Command="{Binding CalculateGoldCommand}" />
                <Button Text="Clear" Command="{Binding ClearCommand}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray400}, Dark={StaticResource Gray600}}" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
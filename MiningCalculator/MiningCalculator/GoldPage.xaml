<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MiningCalculator.GoldPage"
             xmlns:behaviors="clr-namespace:MiningCalculator.Behaviors"
             Title="Gold">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <!-- G/Ton Section -->
            <Label Text="G/Ton" FontAttributes="Bold,Italic" FontSize="20"
                   TextColor="Gold" HorizontalOptions="Center" />

            <HorizontalStackLayout Spacing="10">
                <CheckBox x:Name="chkStopingWidthCm"
                          CheckedChanged="ChkStopingWidthCm_CheckedChanged" />
                <Label Text="Stoping width in centimeters"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto"
                  ColumnSpacing="8" RowSpacing="8">

                <Label Text="CMGT :" Grid.Row="0" Grid.Column="0"
                       VerticalOptions="Center" />
                <Entry x:Name="entryCMGT" Grid.Row="0" Grid.Column="1" Keyboard="Numeric">
                    <Entry.Behaviors>
                        <behaviors:NumericValidationBehavior />
                    </Entry.Behaviors>
                </Entry>

                <Label Text="Stoping Width (SW) :" Grid.Row="1" Grid.Column="0"
                       VerticalOptions="Center" />
                <Entry x:Name="entryStopingWidth" Grid.Row="1" Grid.Column="1" Keyboard="Numeric">
                    <Entry.Behaviors>
                        <behaviors:NumericValidationBehavior />
                    </Entry.Behaviors>
                </Entry>
                <Label x:Name="lblStopingWidthUnit" Text="meter(s)"
                       Grid.Row="1" Grid.Column="2"
                       FontAttributes="Bold" VerticalOptions="Center" />

                <Label Text="Answer :" Grid.Row="2" Grid.Column="0"
                       VerticalOptions="Center" />
                <Label x:Name="lblAnswerGPerTon" Grid.Row="2" Grid.Column="1"
                       FontAttributes="Bold" TextColor="Maroon" FontSize="16"
                       VerticalOptions="Center" />
            </Grid>

            <Button Text="Calculate G/Ton" Clicked="BtnCalculateGPerTon_Clicked"
                    HorizontalOptions="Center" />

            <!-- Tons Section -->
            <Label Text="Tons" FontAttributes="Bold,Italic" FontSize="20"
                   TextColor="Gold" HorizontalOptions="Center" Margin="0,10,0,0" />

            <HorizontalStackLayout Spacing="10">
                <CheckBox x:Name="chkCalcSquareMeters"
                          CheckedChanged="ChkCalcSquareMeters_CheckedChanged" />
                <Label Text="Calculate Square Meters"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnSpacing="8" RowSpacing="8">

                <Label Text="Face Length :" Grid.Row="0" Grid.Column="0"
                       FontAttributes="Bold" VerticalOptions="Center" />
                <Entry x:Name="entryFaceLength" Grid.Row="0" Grid.Column="1"
                       IsEnabled="False" />
                <Label Text="meter(s)" Grid.Row="0" Grid.Column="2"
                       FontAttributes="Bold" VerticalOptions="Center" />

                <Label Text="Face Advance :" Grid.Row="1" Grid.Column="0"
                       FontAttributes="Bold" VerticalOptions="Center" />
                <Entry x:Name="entryFaceAdvance" Grid.Row="1" Grid.Column="1"
                       IsEnabled="False" />
                <Label Text="meter(s)" Grid.Row="1" Grid.Column="2"
                       FontAttributes="Bold" VerticalOptions="Center" />

                <Label Text="Square Metres :" Grid.Row="2" Grid.Column="0"
                       VerticalOptions="Center" />
                <Entry x:Name="entrySquareMetres" Grid.Row="2" Grid.Column="1" />
                <Label Text="m²" Grid.Row="2" Grid.Column="2"
                       VerticalOptions="Center" />

                <Label Text="Answer :" Grid.Row="3" Grid.Column="0"
                       VerticalOptions="Center" />
                <Label x:Name="lblAnswerTons" Grid.Row="3" Grid.Column="1"
                       FontAttributes="Bold" TextColor="Maroon" FontSize="16"
                       VerticalOptions="Center" />
            </Grid>

            <Button Text="Calculate Tons" Clicked="BtnCalculateTons_Clicked"
                    HorizontalOptions="Center" />

            <Label Text="Gold" FontAttributes="Bold,Italic" FontSize="20"
                   TextColor="Gold" HorizontalOptions="Center" Margin="0,10,0,0" />

            <HorizontalStackLayout Spacing="8">
                <Label Text="Answer :" VerticalOptions="Center" />
                <Label x:Name="lblAnswerGold" FontAttributes="Bold"
                       TextColor="Maroon" FontSize="16" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Button Text="Calculate Gold" Clicked="BtnCalculateGold_Clicked" />
                <Button Text="Clear" Clicked="BtnClear_Clicked"
                        BackgroundColor="Gray" TextColor="White" />
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>